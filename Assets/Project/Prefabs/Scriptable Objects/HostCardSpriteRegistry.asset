  - label: Martha Corey
    sprite: {fileID: 699576528662589918, guid: c9a381ea13f9199449c50d3493e49066, type: 3}
    description: You have the same ability as the first living player to your right.
    accent: {r: 0, g: 0, b: 0, a: 0}
  - label: Mary Warren
    sprite: {fileID: 4557740153877582163, guid: e4fcf3fb83a610c408ed920bbcebd952, type: 3}
