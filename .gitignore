# Root .gitignore for salem-1692 repo
# Unity project lives in /unity subfolder

# -----------------------------------------------
# Unity generated folders
# -----------------------------------------------
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Oo]bj/
/unity/[Bb]uild/
/unity/[Bb]uilds/
/unity/[Ll]ogs/
/unity/[Uu]ser[Ss]ettings/
/unity/[Mm]emoryCaptures/
/unity/[Rr]ecordings/

# Unity asset pipeline
/unity/[Aa]ssets/Plugins/Editor/JetBrains*
/unity/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/unity/[Aa]ssets/[Ss]treamingAssets/aa.meta
/unity/[Aa]ssets/[Ss]treamingAssets/aa/*

# -----------------------------------------------
# Unity generated files (any location)
# -----------------------------------------------
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt
crashlytics-build.properties

# Unity builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# -----------------------------------------------
# Editor & IDE
# -----------------------------------------------
.vs/
.gradle/
.consulo/
ExportedObj/

# -----------------------------------------------
# Node.js (server & webclient — added when built)
# -----------------------------------------------
server/node_modules/
webclient/node_modules/
server/.env
webclient/.env